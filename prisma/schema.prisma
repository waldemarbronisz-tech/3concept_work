// Model danych wg docs/PLAN_MVP.md §3. Konwencje: id = cuid, czas = timestamptz (UTC).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Parametry administracyjne (PROJECT.md §2 pkt 11): reguły, które mogą się zmieniać,
/// nie są kodowane na sztywno.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("app_setting")
}

/// Konto logowania (Better Auth + plugin username). Bez e-maila (D2): `email` to
/// adres syntetyczny `<login>@konto.3concept.local`, nigdzie nie pokazywany.
model User {
  id                 String           @id
  name               String
  email              String
  emailVerified      Boolean          @default(false)
  image              String?
  createdAt          DateTime         @default(now()) @db.Timestamptz
  updatedAt          DateTime         @updatedAt @db.Timestamptz
  username           String?
  displayUsername    String?
  mustChangePassword Boolean          @default(true)
  isActive           Boolean          @default(true)
  sessions           Session[]
  accounts           Account[]
  roleAssignments    RoleAssignment[]
  employee           Employee?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

/// Role systemowe (docs/PLAN_MVP.md, D10). Zakres daje `RoleAssignment.siteId`.
enum Role {
  MANAGEMENT
  ADMIN
  CONTRACT_MANAGER
  SITE_ENGINEER
  FOREMAN
  WORKER
}

/// Przypisanie roli z zakresem i historią (§36.1). Użytkownik może mieć wiele ról.
model RoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  /// Budowa jako zakres = numer budowy (klucz biznesowy, §41); null = globalnie (tylko MANAGEMENT i ADMIN).
  siteId    String?
  site      Site?     @relation(fields: [siteId], references: [siteNumber], onDelete: Restrict)
  validFrom DateTime  @default(now()) @db.Timestamptz
  validTo   DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([siteId])
  @@map("role_assignment")
}

enum AuditCategory {
  SYSTEM
  OPERATIONAL
  FINANCIAL
}

/// Ślad zmian — tylko INSERT (docelowo rola bazodanowa aplikacji bez UPDATE/DELETE).
/// `actorUserId` bez relacji: aktorem może być też "system" (seed, zadania w tle).
model AuditLog {
  id          String        @id @default(cuid())
  at          DateTime      @default(now()) @db.Timestamptz
  actorUserId String
  action      String
  category    AuditCategory
  entityType  String
  entityId    String
  siteId      String?
  before      Json?
  after       Json?
  reason      String?

  @@index([entityType, entityId])
  @@index([siteId, at])
  @@index([category, at])
  @@index([at])
  @@map("audit_log")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

/// Dane służbowe osoby (PROJECT.md §16). Konto (`User`) to logowanie; pracownik zostaje
/// w historii po odejściu (soft-delete `deletedAt`, status INACTIVE).
model Employee {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  firstName        String
  lastName         String
  position         String
  employmentStatus EmploymentStatus @default(ACTIVE)
  phone            String?
  deletedAt        DateTime?        @db.Timestamptz
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz
  siteAssignments  SiteAssignment[]

  @@index([lastName, firstName])
  @@map("employee")
}

enum SiteStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// Budowa = kontrakt (D4). `siteNumber` to istniejący numer budowy 3Concept (§41), klucz w URL-ach.
model Site {
  id               String           @id @default(cuid())
  siteNumber       String           @unique
  name             String
  client           String
  location         String
  status           SiteStatus       @default(PLANNED)
  startDate        DateTime?        @db.Date
  endDate          DateTime?        @db.Date
  /// Budżet robocizny w rbh (koszty — tylko role z `costs.*`).
  laborBudgetHours Decimal?         @db.Decimal(10, 2)
  notes            String?
  deletedAt        DateTime?        @db.Timestamptz
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz
  roleAssignments  RoleAssignment[]
  team             SiteAssignment[]

  @@map("site")
}

/// Kto fizycznie jest w zespole budowy, z historią (§36.1). Rola mówi, co ktoś może; to — gdzie pracuje.
model SiteAssignment {
  id         String    @id @default(cuid())
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  validFrom  DateTime  @default(now()) @db.Timestamptz
  validTo    DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([siteId, validTo])
  @@index([employeeId, validTo])
  @@map("site_assignment")
}
