# Skopiuj do .env i uzupełnij. Nigdy nie commituj .env.
# Zmienne dochodzą razem z iteracjami z docs/PLAN_MVP.md.

# Baza lokalna z docker-compose.yml (npm run db:up).
DATABASE_URL="postgresql://app:app@localhost:5432/c3work"
# Baza testowa — używana przez `npm test` (testy integracyjne są pomijane, gdy brak).
DATABASE_URL_TEST="postgresql://app:app@localhost:5432/c3work_test"
